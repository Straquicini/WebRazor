@page
@model ListdragonballModel
@{
    ViewData["Title"] = "Dragon Ball Personagens";
}

<h1>Dragon Ball : Lista de Personagens</h1>

@if (Model.Personagens.Any())
{
    <div style="display: flex; flex-wrap: wrap;">
        @foreach (var personagem in Model.Personagens)
        {
            <div style="border: 1px solid #ccc; margin: 10px; padding: 10px; width: 200px;">
                    <img src="@personagem.Image" class="card-img-top" alt="@personagem.Name" style="height: 300px;" />
                    <h5 class="card-title">@personagem.Name</h5>
                    <p class="card-text text-muted mb-3">ID: @personagem.Id</p>
                    <a asp-page="/Infodragonball" asp-route-cod="@personagem.Id">Ver Info</a>
            </div>
        }
     </div>
}
else
{
    <p>Erro a carregar países, não temos listas</p>
}
